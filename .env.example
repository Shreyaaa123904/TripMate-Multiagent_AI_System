# Copy this file to .env and fill in your own values.
# Never commit .env — it is ignored by git and excluded from Docker builds.

# Groq LLM (https://console.groq.com)
GROQ_API_KEY=

# Tavily web search (https://tavily.com)
TAVILY_API_KEY=

# AviationStack live flight data (https://aviationstack.com)
AVIATIONSTACK_API_KEY=

# PostgreSQL connection string used by the LangGraph PostgresSaver checkpointer
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional: IATA code used as origin when a query only names a destination
DEFAULT_ORIGIN_IATA=DAC
