# Copy this file to .env and fill in your own values.
# Never commit .env — it is ignored by git and excluded from Docker builds.

# Groq LLM (https://console.groq.com)
GROQ_API_KEY=

# Tavily web search (https://tavily.com)
TAVILY_API_KEY=

# AviationStack live flight data (https://aviationstack.com)
AVIATIONSTACK_API_KEY=

# PostgreSQL connection string used by the LangGraph PostgresSaver checkpointer
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional: IATA code used as origin when a query only names a destination
DEFAULT_ORIGIN_IATA=DAC

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown). All are safe to leave unset.
# ---------------------------------------------------------------------------

# Database pool: connections per app process. Keep
#   DB_POOL_MAX x WEB_CONCURRENCY x instances  below your database limit.
# DB_SSLMODE=require
# DB_POOL_MIN=1
# DB_POOL_MAX=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_INIT_RETRY_SECONDS=5
# WEB_CONCURRENCY=1

# LLM
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# Request limits (rate limit is per client IP, per process; 0 disables)
# MAX_MESSAGE_CHARS=2000
# MAX_REQUEST_BYTES=16384
# RATE_LIMIT_PER_MINUTE=10

# Proxy: IPs/CIDRs of the reverse proxy allowed to set X-Forwarded-For
# (read by uvicorn). Default trusts only 127.0.0.1. Never use "*" unless the
# app is reachable only through the proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# LOG_LEVEL=INFO
